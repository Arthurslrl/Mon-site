# Identifiants du compte admin unique du back-office /commandes.
# Utilisés uniquement pour créer le compte au tout premier démarrage
# (si la table admin_users est vide). Pour changer le mot de passe
# ensuite, supprime data/commandes.sqlite3 et relance le serveur,
# ou mets à jour la ligne directement en base.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session du back-office.
# Génère une valeur aléatoire longue, par ex: openssl rand -hex 32
SESSION_SECRET=change-moi-aussi-avec-une-valeur-aleatoire-longue
